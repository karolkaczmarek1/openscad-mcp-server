# Path to OpenSCAD executable (optional, auto-detected; Nightly is preferred)
# OPENSCAD_PATH=C:\Program Files\OpenSCAD (Nightly)\openscad.exe

# Path to OpenSCAD libraries (optional override)
# OPENSCAD_LIBRARIES_PATH=C:\Users\username\Documents\OpenSCAD\libraries

# Directory for .scad/.png/.stl files (optional, default: the MCP client's working directory)
# OPENSCAD_WORKSPACE=C:\Users\username\Documents\OpenSCAD\projects

# Max seconds for a single OpenSCAD call (optional, default: 300)
# OPENSCAD_TIMEOUT=300
